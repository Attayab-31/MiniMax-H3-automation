FLASK_SECRET_KEY=
# Set true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
FERNET_KEY=

# Supabase Postgres connection string. Use the Transaction pooler URL from
# Supabase Dashboard > Connect when deploying from Render.
DATABASE_URL=sqlite:///h3_automation.db
# Private Supabase Storage bucket for persistent generated videos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=h3-videos

KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_KERNEL_ID=yourusername/notebook410ec790c1
KAGGLE_ENABLE_GPU=true
KAGGLE_GPU_TYPE=T4
KAGGLE_MAX_CONCURRENT_ACCOUNTS=8
# Optional live progress callback. URL must be publicly reachable from Kaggle.
# Set a long random token and the public Flask URL up to /api/kaggle/progress.
KAGGLE_CALLBACK_URL=
KAGGLE_CALLBACK_TOKEN=

GEMINI_API_KEY=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
