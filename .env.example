# Required application settings
FLASK_SECRET_KEY=replace-with-a-long-random-session-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_CODE=replace-with-a-separate-random-admin-signup-code
FERNET_KEY=replace-with-a-generated-fernet-key
SESSION_COOKIE_SECURE=false

# Database. Omit to use the local SQLite database in instance/.
# Production should use PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional Supabase private video storage. Set all three together.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=h3-videos

# Optional admin fallback credentials. New users configure these in Settings.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# KAGGLE_KERNEL_ID=
# GEMINI_API_KEY=

# Optional Kaggle notebook settings
KAGGLE_ENABLE_GPU=true
KAGGLE_GPU_TYPE=T4
KAGGLE_MAX_CONCURRENT_ACCOUNTS=4
# KAGGLE_CALLBACK_URL=https://your-app.example.com/api/kaggle/progress
# KAGGLE_CALLBACK_TOKEN=replace-with-a-random-callback-token

# Optional YouTube/TikTok app credentials. Each user stores their own refresh token.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Optional Gemini model override
# GEMINI_MODEL=gemini-2.0-flash

# Optional local server settings
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
